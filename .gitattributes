# Ensure shell scripts and container files always use LF, even when committed
# from a Windows host with core.autocrlf enabled. CRLF would break the shebang
# on Linux for the in-container commands copied from scripts/.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
# In-container commands (extensionless) and the shared dotfiles manifest.
scripts/* text eol=lf
vm/**/*.sh text eol=lf
vm/guest/provision/* text eol=lf
vm/guest/* text eol=lf
vm/conformance/lib.sh text eol=lf
# vm/guest/* is anchored and does not match subdirectories, so units,
# authorized_keys.d and tailnet.d were checked out CRLF on Windows and shipped
# to Linux that way. ** matches at any depth.
vm/guest/** text eol=lf
vm/conformance/** text eol=lf
