#!/bin/bash
echo "=============================================="
echo "       Updating Sandbox Software Suite        "
echo "=============================================="
echo "1/7 Creating automatic safety backup..."
backup "auto-before-update"
echo ""
echo "2/7 Updating system packages (APT)..."
sudo apt-get update && sudo apt-get upgrade -y
echo ""
echo "3/7 Cleaning up old, unnecessary files..."
# Autoremove orphaned packages and clear APT package download caches to save container space
sudo apt-get autoremove -y && sudo apt-get clean
echo ""
echo "4/7 Updating global NPM CLIs..."
sudo npm update -g
echo ""
echo "5/7 Updating Bun..."
sudo bun upgrade || true
echo ""
echo "6/7 Updating Grok CLI..."
(curl -fsSL https://x.ai/cli/install.sh | bash && (sudo cp ~/.local/bin/grok /usr/local/bin/grok 2>/dev/null || true)) || true
echo ""
echo "7/7 Updating Herdr..."
(curl -fsSL https://herdr.dev/install.sh | sh && (sudo cp ~/.local/bin/herdr /usr/local/bin/herdr 2>/dev/null || true)) || true
echo ""
echo "=============================================="
echo "System packages updated and container pruned successfully."
echo "Saved safety backup with label: auto-before-update"
echo "Note: tool updates land in image-managed paths and reset on 'docker compose down/up'."
echo "      Rebuild the image (docker compose up -d --build) to make them durable."
echo "=============================================="
