#!/bin/bash
# Update every tool this image pre-installs, using each tool's own supported update
# path. Runs as the sandbox user; `sudo` is passwordless here and is used only where
# the target is genuinely root-owned (APT, the npm global prefix, /opt bundles).
echo "=============================================="
echo "       Updating Sandbox Software Suite        "
echo "=============================================="

TOTAL=9

# Every tool this image installs lives in exactly one place: /usr/local/bin for the
# binary, /usr/local/lib/<tool> for a bundle. Both are image-managed, and both are owned
# by the sandbox user at build time so a tool's own updater can write to its tree without
# sudo. Nothing here is installed into $HOME, and that is a hard rule rather than a
# preference: $HOME is a persisted volume, and ~/.local/bin precedes /usr/local/bin on
# PATH — so a binary that lands there outlives every rebuild and permanently shadows the
# copy this script maintains, with no error anywhere to say so.
#
# Upstream installers come in two shapes, and each gets the treatment that keeps the rule
# true by construction:
#
#   * takes a destination env var  → point it straight at /usr/local/bin (herdr, hermes).
#   * hardcodes ~/.local/bin       → publish_from_installer below.
publish_from_installer() {
  local name="$1" url="$2" scratch rc=0
  # A throwaway HOME. The installer writes its ~/.local/bin into a temp dir that is
  # deleted on the way out, so only the finished binary survives, in the one place this
  # image manages. Prevention, not detection: there is no state left to go stale.
  scratch="$(mktemp -d)"
  HOME="$scratch" bash -c "curl -fsSL '$url' | bash" >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ] && [ -x "$scratch/.local/bin/$name" ]; then
    # No sudo: /usr/local/bin is chowned to the sandbox user in the Dockerfile.
    install -m 755 "$scratch/.local/bin/$name" "/usr/local/bin/$name"
  else
    echo "    $name update skipped"
  fi
  rm -rf "$scratch"
}

echo "1/$TOTAL Updating system packages (APT)..."
# Covers the base packages plus everything installed from a vendor APT repo: gh, docker
# (engine, CLI, buildx, compose) and the NodeSource nodejs — which stays on its pinned
# major; a major bump is a rebuild with --build-arg NODE_MAJOR=.
sudo apt-get update && sudo apt-get upgrade -y
echo ""
echo "2/$TOTAL Cleaning up old, unnecessary files..."
# Autoremove orphaned packages and clear APT package download caches to save container space
sudo apt-get autoremove -y && sudo apt-get clean
echo ""
echo "3/$TOTAL Updating global NPM CLIs (Claude Code, Codex, Bun, Pi, codeburn, language servers)..."
# Reinstall at @latest rather than `npm update -g`: for globals npm stays within the
# semver range the package was installed under, so it never crosses a major — and these
# CLIs (Claude Code especially) move majors. This is also the *only* update path for
# Claude Code and Codex, since npm's prefix here is /usr and root-owned, so the image
# disables their in-process auto-updaters (see DISABLE_AUTOUPDATER in the Dockerfile).
#
# Bun is in this list because that is how the image installs it — an npm global, not a
# standalone ~/.bun install. `bun upgrade` would replace the binary underneath npm and
# leave npm's recorded version lying; keeping bun on the same path it was installed by
# is the one source of truth. The list mirrors the Dockerfile's npm steps: keep in sync.
sudo npm install -g --no-fund --no-audit \
  @anthropic-ai/claude-code@latest \
  @openai/codex@latest \
  bun@latest \
  pyright@latest \
  typescript@latest \
  typescript-language-server@latest \
  vscode-langservers-extracted@latest \
  yaml-language-server@latest \
  bash-language-server@latest \
  @tailwindcss/language-server@latest
# The two tolerated globals, updated separately for the same reason the Dockerfile
# installs them separately: a registry hiccup on an optional tool must not take the core
# toolchain's update down with it. --ignore-scripts on Pi, per upstream.
sudo npm install -g --no-fund --no-audit codeburn@latest || echo "    codeburn update skipped"
sudo npm install -g --no-fund --no-audit --ignore-scripts @earendil-works/pi-coding-agent@latest \
  || echo "    Pi update skipped"
echo ""
echo "4/$TOTAL Updating Herdr..."
# Installs straight to /usr/local/bin via HERDR_INSTALL_DIR (matches the Dockerfile) —
# the old install-to-~/.local/bin-then-cp dance could silently no-op the cp and leave
# the running binary un-updated with no error.
(curl -fsSL https://herdr.dev/install.sh | sudo env HERDR_INSTALL_DIR=/usr/local/bin sh) || true
echo ""
echo "5/$TOTAL Updating Antigravity CLI (agy)..."
# No install-dir env var upstream — it hardcodes ~/.local/bin, so it runs against a
# throwaway HOME.
publish_from_installer agy https://antigravity.google/cli/install.sh
echo ""
echo "6/$TOTAL Updating Hermes Agent..."
# The agent's own updater: a git pull + dependency sync inside its install tree, run as
# the invoking user. /usr/local/lib/hermes-agent and uv's shared cache are chowned to
# that user at build time, so no ownership work is needed here.
#
# Absolute path, not PATH: `hermes` is a launcher that hard-codes the tree it belongs to,
# so this must name the tree the image owns rather than whichever launcher happens to
# resolve first. If it fails, the closing verification reports it and the fix is a
# rebuild — a reinstall path here would be a second way to produce an install tree,
# which is the thing this script exists to avoid.
/usr/local/bin/hermes update --yes || echo "    hermes update skipped"
echo ""
echo "7/$TOTAL Updating Hermes WebUI..."
# After the agent, deliberately: upstream warns against version skew between the two.
# /opt/hermes-webui is chowned to the sandbox user at build time, so this needs no sudo.
(git -C /opt/hermes-webui pull --ff-only && \
 /opt/hermes-webui/.venv/bin/pip install -q -r /opt/hermes-webui/requirements.txt && \
 /opt/hermes-webui/ctl.sh restart) || true
echo ""
echo "8/$TOTAL Updating docling and the pdftotext bindings..."
# System-Python installs (see the Dockerfile's step 7c for why they are not in a venv),
# so this needs sudo and PEP 668's --break-system-packages, same as the build.
#
# DOCLING_TORCH_INDEX is baked into the image as ENV from the build arg and reaches this
# shell through the entrypoint's ~/.ssh/environment forwarding. It has to be handed to
# pip explicitly via `sudo env`: sudo resets the environment, and without the CPU wheel
# index a plain upgrade would quietly pull PyPI's multi-gigabyte CUDA torch build.
#
# `-` and not `:-`: the fallback is for an image built before this arg existed (variable
# absent entirely). Set-but-empty is a deliberate choice — someone who built with
# --build-arg DOCLING_TORCH_INDEX="" asked for PyPI's default wheel, and re-imposing the
# CPU index here would quietly overrule them on every update.
sudo env DOCLING_TORCH_INDEX="${DOCLING_TORCH_INDEX-https://download.pytorch.org/whl/cpu}" \
  sh -c 'python3 -m pip install --upgrade --no-cache-dir --break-system-packages \
           ${DOCLING_TORCH_INDEX:+--extra-index-url "$DOCLING_TORCH_INDEX"} \
           docling pdftotext' \
  || echo "    docling / pdftotext update skipped"
echo ""
echo "9/$TOTAL Updating the dotfiles tool..."
# A single self-contained script, installed in the image by Docker's ADD from this same
# URL. Downloaded to a temp file and smoke-tested before being swapped in, so a truncated
# or unavailable download cannot leave the box without a working `dotfiles` — the tool
# `onboard` depends on.
DOTTER_REPO="${DOTTER_REPO:-execsumo/dotter}"
DOTTER_REF="${DOTTER_REF:-main}"
DOTFILES_TMP="$(mktemp)"
if curl -fsSL "https://raw.githubusercontent.com/${DOTTER_REPO}/${DOTTER_REF}/bin/dotfiles" \
     -o "$DOTFILES_TMP" \
   && chmod 755 "$DOTFILES_TMP" \
   && "$DOTFILES_TMP" version >/dev/null 2>&1; then
  sudo cp -f "$DOTFILES_TMP" /usr/local/bin/dotfiles && sudo chmod 755 /usr/local/bin/dotfiles
else
  echo "    dotfiles update skipped"
fi
rm -f "$DOTFILES_TMP"
echo ""
# Every step above is tolerated (`|| true`) so one unreachable installer cannot stop the
# rest of the update — which also means a failure scrolls past. Close with the same check
# the Dockerfile's step 8 runs, so the state of the toolchain after an update is stated
# rather than assumed. `--version` rather than `command -v`: a half-updated launcher
# still exists and is still executable.
echo "Verifying the toolchain..."
for t in claude codex bun node npm gh docker hermes herdr agy codeburn pi dotfiles docling; do
  if ! command -v "$t" >/dev/null 2>&1; then
    printf '  %-12s MISSING\n' "$t"
  elif ! "$t" --version >/dev/null 2>&1; then
    printf '  %-12s BROKEN (installed, but fails to run)\n' "$t"
  else
    printf '  %-12s ok\n' "$t"
  fi
done
# The pdftotext bindings ship no CLI, so importing them is the only check that says
# whether the compiled extension still loads — the `pdftotext` command on PATH is
# poppler-utils, a different package entirely.
if python3 -c 'import pdftotext' >/dev/null 2>&1; then
  printf '  %-12s ok\n' "pdftotext"
else
  printf '  %-12s MISSING\n' "pdftotext"
fi
if [ -x /opt/hermes-webui/ctl.sh ]; then
  printf '  %-12s ok\n' "hermes-webui"
else
  printf '  %-12s MISSING\n' "hermes-webui"
fi
echo ""
echo "=============================================="
echo "System packages updated and container pruned successfully."
echo "Note: tool updates land in image-managed paths and reset on 'docker compose down/up'."
echo "      Rebuild the image (docker compose up -d --build) to make them durable."
echo "      The tailscale sidecars are separate containers — update them from the"
echo "      host with 'docker compose pull && docker compose up -d'."
echo "=============================================="
