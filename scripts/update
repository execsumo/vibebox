#!/bin/bash
echo "=============================================="
echo "       Updating Sandbox Software Suite        "
echo "=============================================="
echo "1/9 Creating automatic safety backup..."
backup "auto-before-update"
echo ""
echo "2/9 Updating system packages (APT)..."
sudo apt-get update && sudo apt-get upgrade -y
echo ""
echo "3/9 Cleaning up old, unnecessary files..."
# Autoremove orphaned packages and clear APT package download caches to save container space
sudo apt-get autoremove -y && sudo apt-get clean
echo ""
echo "4/9 Updating global NPM CLIs (Claude Code, Codex, Pi, codeburn, language servers)..."
sudo npm update -g
echo ""
echo "5/9 Updating Bun..."
sudo bun upgrade || true
echo ""
echo "6/9 Updating Herdr..."
# Installs straight to /usr/local/bin via HERDR_INSTALL_DIR (matches the Dockerfile) —
# the old install-to-~/.local/bin-then-cp dance could silently no-op the cp and leave
# the running binary un-updated with no error.
(curl -fsSL https://herdr.dev/install.sh | sudo env HERDR_INSTALL_DIR=/usr/local/bin sh) || true
echo ""
echo "7/9 Updating Hermes Agent..."
(curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash && (sudo cp ~/.local/bin/hermes /usr/local/bin/hermes 2>/dev/null || true)) || true
echo ""
echo "8/9 Updating CodeGraph..."
# Must mirror the Dockerfile: the launcher resolves its bundle relative to itself, so
# it stays a symlink into /opt/codegraph rather than being copied into /usr/local/bin.
(curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | \
   sudo env CODEGRAPH_INSTALL_DIR=/opt/codegraph CODEGRAPH_BIN_DIR=/usr/local/bin sh && \
 sudo chmod -R a+rX /opt/codegraph) || true
echo "    Re-run 'codegraph install' if you added or removed agent CLIs."
echo ""
echo "9/9 Updating Hermes WebUI..."
(git -C /opt/hermes-webui pull --ff-only && \
 /opt/hermes-webui/.venv/bin/pip install -q -r /opt/hermes-webui/requirements.txt && \
 /opt/hermes-webui/ctl.sh restart) || true
echo ""
echo "=============================================="
echo "System packages updated and container pruned successfully."
echo "Saved safety backup with label: auto-before-update"
echo "Note: tool updates land in image-managed paths and reset on 'docker compose down/up'."
echo "      Rebuild the image (docker compose up -d --build) to make them durable."
echo "=============================================="
