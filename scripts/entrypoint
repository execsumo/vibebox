#!/bin/bash
# Container entrypoint. Generates SSH host keys once into a dedicated named
# volume so the sandbox keeps a stable identity across rebuilds (no
# "host key changed" warnings), then hands off to the given command (sshd).
set -e

# Resolve the sandbox user's home (UID 1000) regardless of the configured username.
SANDBOX_HOME="$(getent passwd 1000 | cut -d: -f6)"
VIBEBOX_DIR="$SANDBOX_HOME/.vibebox"

# When home is a host bind mount (SANDBOX_HOME_HOST_PATH), first boot is detected
# by the absence of .vibebox (home is never literally empty — Docker creates .ssh
# for the nested authorized_keys mount before this script runs). Seed the folder
# with the skel files — no-clobber, so existing host files win — and hand
# ownership to the sandbox user. A named volume self-seeds from the image
# instead, so this only runs for bind mounts.
if [ -n "${SANDBOX_HOME_HOST_PATH:-}" ] && [ ! -d "$VIBEBOX_DIR" ]; then
  cp -rn /etc/skel/. "$SANDBOX_HOME/" 2>/dev/null || true
  chown -R 1000:1000 "$SANDBOX_HOME" 2>/dev/null || true
fi

# Host keys live on their own named volume, not in home: sshd rejects host keys
# whose permission bits are too open, and those bits are not reliable on host
# bind mounts (SANDBOX_HOME_HOST_PATH).
KEYDIR=/opt/vibebox/ssh
mkdir -p "$VIBEBOX_DIR" "$KEYDIR"

# One-time migration: host keys used to live under ~/.vibebox/ssh in the home
# volume. Move them to the dedicated volume so the sandbox keeps its identity
# (no "host key changed" warning) across this upgrade.
if [ ! -f "$KEYDIR/ssh_host_ed25519_key" ] && [ -f "$VIBEBOX_DIR/ssh/ssh_host_ed25519_key" ]; then
  mv "$VIBEBOX_DIR"/ssh/ssh_host_* "$KEYDIR/"
  rmdir "$VIBEBOX_DIR/ssh" 2>/dev/null || true
fi

# mkdir above runs as root, so .vibebox lands root-owned — but `onboard` writes its
# marker files (rtk-initialized, codegraph-installed) there as the sandbox user, and
# the failed redirect aborts onboard under `set -e`. Chown the directory itself.
# Runs every boot, so existing volumes with the old root-owned dir self-heal.
# || true: some host bind-mount filesystems reject chown; don't abort the boot.
chown 1000:1000 "$VIBEBOX_DIR" 2>/dev/null || true

# Runs as root, so the generated private keys are root-owned mode 600 — the
# standard, always-accepted case for sshd HostKey files.
[ -f "$KEYDIR/ssh_host_ed25519_key" ] || ssh-keygen -q -t ed25519 -f "$KEYDIR/ssh_host_ed25519_key" -N ""
[ -f "$KEYDIR/ssh_host_rsa_key" ]     || ssh-keygen -q -t rsa -b 4096 -f "$KEYDIR/ssh_host_rsa_key" -N ""

# Forward the container environment (everything from .env, via compose env_file) to
# SSH sessions. sshd does not inherit PID 1's environment, so without this a key set
# in .env is invisible to every shell in the box. Paired with PermitUserEnvironment
# in the Dockerfile. Rewritten from scratch each boot, so a key deleted from .env
# actually disappears instead of lingering in the persisted home volume.
SSH_ENV_FILE="$SANDBOX_HOME/.ssh/environment"
mkdir -p "$SANDBOX_HOME/.ssh"
: > "$SSH_ENV_FILE"
# Written as root but read by sshd as the sandbox user: 0600 keeps API keys out of
# reach of anything else, and the chown is what makes them readable at all.
# || true: some host bind-mount filesystems reject chmod/chown; don't abort the boot.
chmod 600 "$SSH_ENV_FILE" 2>/dev/null || true
chown 1000:1000 "$SSH_ENV_FILE" 2>/dev/null || true
while IFS= read -r -d '' kv; do
  name="${kv%%=*}"
  value="${kv#*=}"
  case "$name" in
    # Session-scoped, not configuration. sshd and the login shell set these per
    # session; exporting the entrypoint's copies would point every login at root's
    # HOME and pin PATH to the build-time value.
    PATH|HOME|USER|LOGNAME|SHELL|PWD|OLDPWD|SHLVL|TERM|MAIL|HOSTNAME|_) continue ;;
  esac
  # The file format is one NAME=value per line with no quoting or continuations,
  # so an embedded newline would silently corrupt every entry after it.
  case "$value" in
    *$'\n'*) echo "skipping \$$name in ssh environment (value contains a newline)"; continue ;;
  esac
  printf '%s=%s\n' "$name" "$value" >> "$SSH_ENV_FILE"
done < <(env -0)

# Host-created files (e.g. repos cloned on Windows into a bind-mounted home)
# appear root-owned in the container, and git refuses to touch them ("detected
# dubious ownership"). A wildcard safe.directory is acceptable in a single-user
# sandbox; only applied when home is a host bind mount.
if [ -n "${SANDBOX_HOME_HOST_PATH:-}" ]; then
  runuser -u "$(getent passwd 1000 | cut -d: -f1)" -- env HOME="$SANDBOX_HOME" sh -c \
    "git config --global --get-all safe.directory 2>/dev/null | grep -qx '\*' || git config --global --add safe.directory '*'" || true
fi

# Handle Docker daemon startup & socket permissions.
# On Windows host, docker compose bind-mounting /var/run/docker.sock creates a directory instead of a socket.
if [ -d /var/run/docker.sock ]; then
  rmdir /var/run/docker.sock 2>/dev/null || true
fi

if [ -S /var/run/docker.sock ]; then
  chown root:docker /var/run/docker.sock 2>/dev/null || true
  chmod 666 /var/run/docker.sock 2>/dev/null || true
elif command -v service >/dev/null 2>&1; then
  service docker start >/dev/null 2>&1 || true
  if [ -S /var/run/docker.sock ]; then
    chown root:docker /var/run/docker.sock 2>/dev/null || true
    chmod 666 /var/run/docker.sock 2>/dev/null || true
  fi
fi

# Start Hermes WebUI as the sandbox user if installed (daemonized via ctl.sh, so
# sshd startup is not blocked; failure is non-fatal). Binds 0.0.0.0 so the
# hermes-ts tailscale sidecar can proxy https://<HERMES_HOSTNAME>.<tailnet>.ts.net
# to it across the compose network. HERMES_WEBUI_PASSWORD comes from .env via the
# compose environment and is effectively required for the non-localhost bind.
if [ -x /opt/hermes-webui/ctl.sh ]; then
  SANDBOX_USER="$(getent passwd 1000 | cut -d: -f1)"
  runuser -u "$SANDBOX_USER" -- env \
    HOME="$SANDBOX_HOME" \
    HERMES_WEBUI_HOST="${HERMES_WEBUI_HOST:-0.0.0.0}" \
    HERMES_WEBUI_PORT=8787 \
    HERMES_WEBUI_PASSWORD="${HERMES_WEBUI_PASSWORD:-}" \
    /opt/hermes-webui/ctl.sh start || echo "hermes-webui failed to start (non-fatal)"
fi

exec "$@"
