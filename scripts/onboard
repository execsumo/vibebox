#!/bin/bash
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

step() { echo -e "\n${CYAN}==>${RESET} $*"; }
ok()   { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}!${RESET} $*"; }

echo ""
echo "================================================"
echo "           Vibebox First-Time Setup"
echo "================================================"

# ── 1. GitHub CLI auth ────────────────────────────────────────────────────────
step "GitHub CLI authentication"
if gh auth status &>/dev/null; then
  GH_USER=$(gh api /user --jq '.login' 2>/dev/null || true)
  ok "Already authenticated as ${GH_USER:-unknown}"
else
  gh auth login
  GH_USER=$(gh api /user --jq '.login')
  ok "Authenticated as ${GH_USER}"
fi

# ── 2. Git identity ───────────────────────────────────────────────────────────
step "Git identity"
CURRENT_NAME=$(git config --global user.name 2>/dev/null || true)
CURRENT_EMAIL=$(git config --global user.email 2>/dev/null || true)

if [ -n "$CURRENT_NAME" ] && [ -n "$CURRENT_EMAIL" ]; then
  ok "Already set: ${CURRENT_NAME} <${CURRENT_EMAIL}>"
else
  GH_NAME=$(gh api /user --jq '.name // ""' 2>/dev/null || true)
  GH_EMAIL=$(gh api /user/emails --jq '[.[] | select(.primary)][0].email // ""' 2>/dev/null || true)

  if [ -z "$CURRENT_NAME" ]; then
    DEFAULT_NAME="${GH_NAME:-}"
    read -rp "  Full name [${DEFAULT_NAME}]: " INPUT_NAME
    git config --global user.name "${INPUT_NAME:-$DEFAULT_NAME}"
  fi
  if [ -z "$CURRENT_EMAIL" ]; then
    DEFAULT_EMAIL="${GH_EMAIL:-}"
    read -rp "  Email [${DEFAULT_EMAIL}]: " INPUT_EMAIL
    git config --global user.email "${INPUT_EMAIL:-$DEFAULT_EMAIL}"
  fi
  ok "Git identity set: $(git config --global user.name) <$(git config --global user.email)>"
fi

# ── 3. Dotfiles ───────────────────────────────────────────────────────────────
# Delegated to the standalone `dotfiles` tool (https://github.com/execsumo/dotter).
# vibebox is just one consumer of it: the manifest, the git mechanics, and the
# symlinking all live there and work identically on a laptop or a VPS. The same
# two commands below are what you would run anywhere else.
step "Dotfiles"

if ! command -v dotfiles &>/dev/null; then
  warn "dotfiles tool not installed — skipping (rebuild the image to install it)"
else
  DOTFILES_REPO="https://github.com/${GH_USER}/dotfiles"
  read -rp "  Dotfiles repo [${DOTFILES_REPO}]: " INPUT_REPO
  REPO="${INPUT_REPO:-$DOTFILES_REPO}"

  # No --yes: if the repo does not exist yet, creating it on GitHub is an
  # outward-facing action and should stay an explicit human confirmation.
  if dotfiles init --repo "$REPO"; then
    # `link` renames any real file or directory it collides with to <name>.bak
    # before symlinking the repo copy in. For a tracked ~/.hermes that rename
    # fails with "Permission denied" while the Hermes WebUI is running — but
    # only when home is a host bind mount (SANDBOX_HOME_HOST_PATH): 9p/drvfs
    # carries Windows semantics, where a directory holding open file handles
    # (the daemon's webui.log and state.db-wal) cannot be renamed at all. A
    # named-volume home renames it happily. So pause the daemon — started at
    # boot by the entrypoint — for the seconds the link takes.
    WEBUI_PID_FILE="${HERMES_WEBUI_PID_FILE:-${HERMES_HOME:-$HOME/.hermes}/webui.pid}"
    WEBUI_PAUSED=0
    if [ -x /opt/hermes-webui/ctl.sh ] && [ -s "$WEBUI_PID_FILE" ]; then
      echo "  Pausing Hermes WebUI while dotfiles are linked..."
      /opt/hermes-webui/ctl.sh stop >/dev/null 2>&1 || true
      WEBUI_PAUSED=1
    fi

    LINK_OK=0
    dotfiles link && LINK_OK=1

    if [ "$WEBUI_PAUSED" -eq 1 ]; then
      # No env passed: the binding and password come from /opt/hermes-webui/.env,
      # which the entrypoint writes with what it used at boot. HERMES_WEBUI_PASSWORD
      # is not in this shell's environment (the entrypoint withholds it), so
      # passing it through explicitly would resume the webui *unauthenticated*
      # on its tailnet-facing bind.
      if /opt/hermes-webui/ctl.sh start >/dev/null 2>&1; then
        ok "Hermes WebUI restarted"
      else
        warn "Hermes WebUI did not resume — start it manually: hermes-webui start"
      fi
    fi

    if [ "$LINK_OK" -eq 1 ]; then
      # Re-source zshrc if we're in zsh
      [ -n "${ZSH_VERSION:-}" ] && [ -f "$HOME/.zshrc" ] && source "$HOME/.zshrc"
    else
      warn "Dotfiles step did not complete — re-run 'onboard', or debug with:"
      warn "  dotfiles status"
    fi
  else
    warn "Dotfiles step did not complete — re-run 'onboard', or debug with:"
    warn "  dotfiles status"
  fi
fi

# ── 4. CodeGraph agent wiring ─────────────────────────────────────────────────
# Registers CodeGraph's MCP server with whichever agent CLIs are installed. This
# cannot be baked into the image: it writes per-user config into $HOME (e.g.
# ~/.claude.json), and $HOME is a persisted volume that masks image content. Run
# here it lands in the volume and survives rebuilds.
step "CodeGraph agent wiring"
CODEGRAPH_MARKER="$HOME/.vibebox/codegraph-installed"

if ! command -v codegraph &>/dev/null; then
  warn "codegraph not installed — skipping (rebuild the image to install it)"
elif [ -f "$CODEGRAPH_MARKER" ]; then
  ok "Already wired up ($(cat "$CODEGRAPH_MARKER"))"
  echo "    Re-run with: codegraph install"
else
  if codegraph install; then
    # Bookkeeping only — never let it abort the run (set -e) and skip the steps
    # below. A missing marker only costs a redundant re-run next time.
    mkdir -p "$(dirname "$CODEGRAPH_MARKER")" 2>/dev/null || true
    date -u '+wired %Y-%m-%d' > "$CODEGRAPH_MARKER" 2>/dev/null \
      || warn "Could not write marker ${CODEGRAPH_MARKER} (install itself succeeded)"
    ok "CodeGraph registered with the installed agent CLIs"
    echo "    Index a project by running 'codegraph' inside its directory."
  else
    warn "codegraph install failed — re-run 'codegraph install' manually"
  fi
fi

echo ""
echo "================================================"
echo "  Setup complete. Enjoy your sandbox."
echo "================================================"
echo ""
