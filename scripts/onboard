#!/bin/bash
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

step() { echo -e "\n${CYAN}==>${RESET} $*"; }
ok()   { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}!${RESET} $*"; }

MANIFEST="/usr/local/share/vibebox/dotfiles.manifest"

echo ""
echo "================================================"
echo "           Vibebox First-Time Setup"
echo "================================================"

# ── 1. GitHub CLI auth ────────────────────────────────────────────────────────
step "GitHub CLI authentication"
if gh auth status &>/dev/null; then
  GH_USER=$(gh api /user --jq '.login' 2>/dev/null || true)
  ok "Already authenticated as ${GH_USER:-unknown}"
else
  gh auth login
  GH_USER=$(gh api /user --jq '.login')
  ok "Authenticated as ${GH_USER}"
fi

# ── 2. Git identity ───────────────────────────────────────────────────────────
step "Git identity"
CURRENT_NAME=$(git config --global user.name 2>/dev/null || true)
CURRENT_EMAIL=$(git config --global user.email 2>/dev/null || true)

if [ -n "$CURRENT_NAME" ] && [ -n "$CURRENT_EMAIL" ]; then
  ok "Already set: ${CURRENT_NAME} <${CURRENT_EMAIL}>"
else
  GH_NAME=$(gh api /user --jq '.name // ""' 2>/dev/null || true)
  GH_EMAIL=$(gh api /user/emails --jq '[.[] | select(.primary)][0].email // ""' 2>/dev/null || true)

  if [ -z "$CURRENT_NAME" ]; then
    DEFAULT_NAME="${GH_NAME:-}"
    read -rp "  Full name [${DEFAULT_NAME}]: " INPUT_NAME
    git config --global user.name "${INPUT_NAME:-$DEFAULT_NAME}"
  fi
  if [ -z "$CURRENT_EMAIL" ]; then
    DEFAULT_EMAIL="${GH_EMAIL:-}"
    read -rp "  Email [${DEFAULT_EMAIL}]: " INPUT_EMAIL
    git config --global user.email "${INPUT_EMAIL:-$DEFAULT_EMAIL}"
  fi
  ok "Git identity set: $(git config --global user.name) <$(git config --global user.email)>"
fi

# ── 3. Dotfiles ───────────────────────────────────────────────────────────────
step "Dotfiles"
DOTFILES_DIR="$HOME/.dotfiles"
DOTFILES_REPO="https://github.com/${GH_USER}/dotfiles"

if [ -d "$DOTFILES_DIR/.git" ]; then
  ok "Dotfiles already installed at ${DOTFILES_DIR}"
else
  read -rp "  Dotfiles repo [${DOTFILES_REPO}]: " INPUT_REPO
  REPO="${INPUT_REPO:-$DOTFILES_REPO}"

  if gh repo view "${GH_USER}/dotfiles" &>/dev/null 2>&1 || \
     git ls-remote "$REPO" &>/dev/null 2>&1; then
    git clone "$REPO" "$DOTFILES_DIR"

    # Supported dotfiles come from the shared manifest (mirrors dotfiles-init.sh).
    # Files are symlinked individually; directories are symlinked whole.
    SUPPORTED_FILES=()
    SUPPORTED_DIRS=()
    if [ -f "$MANIFEST" ]; then
      while IFS='|' read -r TYPE REL _; do
        case "$TYPE" in
          file) SUPPORTED_FILES+=("$REL") ;;
          dir)  SUPPORTED_DIRS+=("$REL") ;;
        esac
      done < <(grep -vE '^[[:space:]]*(#|$)' "$MANIFEST")
    else
      warn "Dotfiles manifest not found at ${MANIFEST}; skipping dotfile linking"
    fi

    LINKED=()

    for f in "${SUPPORTED_FILES[@]}"; do
      SRC="$DOTFILES_DIR/$f"
      DEST="$HOME/$f"
      if [ -f "$SRC" ]; then
        mkdir -p "$(dirname "$DEST")"
        [ -e "$DEST" ] && ! [ -L "$DEST" ] && mv "$DEST" "${DEST}.bak"
        ln -sf "$SRC" "$DEST"
        LINKED+=("$f")
      fi
    done

    for d in "${SUPPORTED_DIRS[@]}"; do
      SRC="$DOTFILES_DIR/$d"
      DEST="$HOME/$d"
      if [ -d "$SRC" ]; then
        mkdir -p "$(dirname "$DEST")"
        [ -e "$DEST" ] && ! [ -L "$DEST" ] && mv "$DEST" "${DEST}.bak"
        ln -sf "$SRC" "$DEST"
        LINKED+=("$d/")
      fi
    done

    if [ ${#LINKED[@]} -gt 0 ]; then
      ok "Linked: ${LINKED[*]}"
    else
      warn "No supported dotfiles found in repo (see README for expected filenames)"
    fi

    # Re-source zshrc if we're in zsh
    [ -n "${ZSH_VERSION:-}" ] && [ -f "$HOME/.zshrc" ] && source "$HOME/.zshrc"
  else
    warn "Repo ${REPO} not found or not accessible — skipping dotfiles"
    warn "Create it at https://github.com/new or re-run 'onboard' later"
  fi
fi

# ── 4. RTK agent wiring ───────────────────────────────────────────────────────
# Installs RTK's auto-rewrite hook into each agent CLI that is actually present,
# so command output is compressed before it reaches the agent's context. Like
# CodeGraph below, this writes per-user config into $HOME (~/.config/rtk/ plus
# each agent's own config), so it cannot be baked into the image — $HOME is a
# persisted volume that masks image content on rebuilds.
step "RTK agent wiring"
RTK_MARKER="$HOME/.vibebox/rtk-initialized"

if ! command -v rtk &>/dev/null; then
  warn "rtk not installed — skipping (rebuild the image to install it)"
elif [ -f "$RTK_MARKER" ]; then
  ok "Already wired up ($(cat "$RTK_MARKER"))"
  echo "    Re-run with: rtk init -g --auto-patch   (add --agent <name> per agent)"
else
  # binary|label|extra flags. Claude Code is RTK's default target and takes no flag.
  RTK_AGENTS=(
    "claude|Claude Code|"
    "codex|Codex CLI|--codex"
    "agy|Antigravity|--agent antigravity"
    "hermes|Hermes Agent|--agent hermes"
    "pi|Pi|--agent pi"
  )

  RTK_WIRED=()
  RTK_FAILED=()

  for entry in "${RTK_AGENTS[@]}"; do
    IFS='|' read -r BIN LABEL FLAGS <<<"$entry"
    command -v "$BIN" &>/dev/null || continue
    # shellcheck disable=SC2086 -- FLAGS is intentionally word-split
    if rtk init -g $FLAGS --auto-patch &>/dev/null; then
      RTK_WIRED+=("$LABEL")
    else
      RTK_FAILED+=("$LABEL")
    fi
  done

  if [ ${#RTK_WIRED[@]} -gt 0 ]; then
    mkdir -p "$(dirname "$RTK_MARKER")"
    date -u '+wired %Y-%m-%d' > "$RTK_MARKER"
    ok "RTK hook installed for: ${RTK_WIRED[*]}"
  fi
  if [ ${#RTK_FAILED[@]} -gt 0 ]; then
    warn "RTK wiring failed for: ${RTK_FAILED[*]}"
    warn "Re-run manually, e.g.: rtk init -g --agent <name>   (see 'rtk init --help')"
  fi
  if [ ${#RTK_WIRED[@]} -eq 0 ] && [ ${#RTK_FAILED[@]} -eq 0 ]; then
    warn "No supported agent CLIs found — nothing to wire"
  fi
fi

# ── 5. CodeGraph agent wiring ─────────────────────────────────────────────────
# Registers CodeGraph's MCP server with whichever agent CLIs are installed. This
# cannot be baked into the image: it writes per-user config into $HOME (e.g.
# ~/.claude.json), and $HOME is a persisted volume that masks image content. Run
# here it lands in the volume and survives rebuilds.
step "CodeGraph agent wiring"
CODEGRAPH_MARKER="$HOME/.vibebox/codegraph-installed"

if ! command -v codegraph &>/dev/null; then
  warn "codegraph not installed — skipping (rebuild the image to install it)"
elif [ -f "$CODEGRAPH_MARKER" ]; then
  ok "Already wired up ($(cat "$CODEGRAPH_MARKER"))"
  echo "    Re-run with: codegraph install"
else
  if codegraph install; then
    mkdir -p "$(dirname "$CODEGRAPH_MARKER")"
    date -u '+wired %Y-%m-%d' > "$CODEGRAPH_MARKER"
    ok "CodeGraph registered with the installed agent CLIs"
    echo "    Index a project by running 'codegraph' inside its directory."
  else
    warn "codegraph install failed — re-run 'codegraph install' manually"
  fi
fi

echo ""
echo "================================================"
echo "  Setup complete. Enjoy your sandbox."
echo "================================================"
echo ""
