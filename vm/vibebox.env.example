# Vibebox VM configuration. Values are plain KEY=VALUE pairs.
# Comments must start at the beginning of a line. Do not put secrets here.

# Instance
VM_NAME=vibebox-vm
UBUNTU_RELEASE=24.04
VM_CPUS=4
# Hyper-V dynamic memory bounds. Applied by `vibebox memory apply`,
# which needs an elevated shell; nothing else does.
VM_MEMORY_MIN=1G
VM_MEMORY_STARTUP=2G
VM_MEMORY=4G
# VM_DISK is grow-only; it cannot be shrunk after create.
VM_DISK=32G

# Host behavior
# Allowed values: shutdown or save.

# Guest policy
GUEST_USER=dev
GUEST_SHELL=/bin/zsh
GUEST_UFW=false
GUEST_SWAP_GB=2
# Tag advertised at enrollment. Must match a tag the auth key was issued
# with, and must exist in the tailnet ACL tagOwners. Empty = advertise none.
TAILSCALE_TAG=
GUEST_TIMEZONE=America/Los_Angeles

# Toolchain
NODE_MAJOR=22
TOOLS_OPTIONAL=agy,herdr,rtk,droid,hermes,hermes-webui,codeburn,pi,codegraph,gws,infisical
# Allowed values: latest or locked.
TOOLS_UPDATE_POLICY=latest

# Maintenance: the scheduled jobs vibebox runs in the guest (platform only;
# never your apps, containers, or volumes, and never a reboot).
#   daily  -- updates the toolchain (`update tools`)
#   weekly -- updates OS packages and the toolchain (`update all`), trims the
#             journal, prunes Docker images and build cache unused for a week
# Times are systemd calendar expressions: 01:00 is every day, Sun 02:00 every
# Sunday. Leave one empty to turn that job off. Apply changes with
# `vibebox maintenance apply`.
MAINTENANCE_ENABLED=true
MAINTENANCE_DAILY_AT=01:00
MAINTENANCE_WEEKLY_AT=Sun 02:00

# Operations
BACKUP_DEST=D:/vibebox-backups
BACKUP_RETENTION_DAYS=7
READINESS_TIMEOUT_SEC=90
