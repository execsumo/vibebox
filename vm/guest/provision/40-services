#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG_FILE=${1:?configuration file is required}
ROOT=${VIBEBOX_ROOT:-/opt/vibebox}
# shellcheck source=/dev/null
source "$ROOT/read-env.sh"
read_vibebox_env "$CONFIG_FILE"

install -d -m 0755 /etc/systemd/system
for unit in "$ROOT"/units/*.service "$ROOT"/units/*.timer; do
    [[ -f "$unit" ]] || continue
    install -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
done

install -m 0755 "$ROOT/grow-disk.sh" /usr/local/sbin/vibebox-grow-disk
install -m 0755 "$ROOT/backup-producer" /usr/local/sbin/vibebox-backup-producer
install -m 0755 "$ROOT/tailnet-reconcile.sh" /usr/local/sbin/vibebox-tailnet-reconcile
install -m 0755 "$ROOT/tailnet-status.sh" /usr/local/sbin/vibebox-tailnet-status
install -d -m 0755 /etc/vibebox/tailnet.d
find /etc/vibebox/tailnet.d -mindepth 1 -maxdepth 1 -type f -name '*.conf' -delete
if [[ -d "$ROOT/tailnet.d" ]]; then
    install -m 0644 "$ROOT"/tailnet.d/*.conf /etc/vibebox/tailnet.d/ 2>/dev/null || true
fi
install -m 0644 "$CONFIG_FILE" /etc/vibebox/vibebox.env
systemctl daemon-reload

systemctl enable --now vibebox-grow-disk.service
systemctl enable --now vibebox-tailnet.service
systemctl restart vibebox-tailnet.service

if command -v hermes >/dev/null 2>&1; then
    systemctl enable --now "vibebox-hermes-gateway@$GUEST_USER.service"
else
    printf 'optional service skipped: hermes is not installed\n' >&2
fi

if command -v droid >/dev/null 2>&1; then
    systemctl enable --now "vibebox-droid-daemon@$GUEST_USER.service"
else
    printf 'optional service skipped: droid is not installed\n' >&2
fi

if [[ -x /opt/hermes-webui/ctl.sh ]]; then
    systemctl enable --now "vibebox-hermes-webui@$GUEST_USER.service"
else
    printf 'optional service skipped: Hermes WebUI is not installed\n' >&2
fi

# In-guest commands on PATH. The legacy container shipped these in
# /usr/local/bin; the VM keeps the ones that still make sense. Deliberately
# absent are the shims that faked npm/pip3/systemctl/tailscale for a box with
# no init -- a VM has the real thing, and shadowing a real CLI is exactly what
# the design forbids.
if [[ -d "$ROOT/bin" ]]; then
    for cmd in "$ROOT/bin"/*; do
        [[ -f "$cmd" ]] || continue
        install -m 0755 "$cmd" "/usr/local/bin/$(basename "$cmd")"
    done
    echo "guest commands installed: $(ls "$ROOT/bin" | xargs)"
fi

# Clear stale failure counters before touching units. A unit that hit its
# start limit refuses `systemctl start` until it is reset, so without this a
# re-provision that fixes the underlying problem still looks broken.
systemctl reset-failed "vibebox-*" 2>/dev/null || true

# Authorized keys declared in git, so they survive a rebuild. Installed into a
# marker-delimited block that provisioning owns; anything the user added to the
# file by hand sits outside the markers and is preserved, so re-provisioning
# can never lock someone out of their own box.
keys_dir="$ROOT/authorized_keys.d"
auth_file="/home/$GUEST_USER/.ssh/authorized_keys"
begin="# >>> vibebox authorized_keys.d >>>"
end="# <<< vibebox authorized_keys.d <<<"
if [[ -d "$keys_dir" ]]; then
    install -d -m 700 -o "$GUEST_USER" -g "$GUEST_USER" "/home/$GUEST_USER/.ssh"
    touch "$auth_file"
    tmp=$(mktemp)
    awk -v b="$begin" -v e="$end" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip   { print }
    ' "$auth_file" > "$tmp"
    declared=0
    {
        echo "$begin"
        for key in "$keys_dir"/*.pub; do
            [[ -e "$key" ]] || continue
            while IFS= read -r line || [[ -n "$line" ]]; do
                line=$(printf %s "$line" | tr -d '\r')
                [[ -z "${line//[[:space:]]/}" ]] && continue
                case "$line" in \#*) continue ;; esac
                echo "$line"
                declared=$((declared + 1))
            done < "$key"
        done
        echo "$end"
    } >> "$tmp"
    install -m 600 -o "$GUEST_USER" -g "$GUEST_USER" "$tmp" "$auth_file"
    rm -f "$tmp"
    echo "authorized_keys: $declared declared key(s) installed"
fi
