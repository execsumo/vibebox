# Single source of truth for supported dotfiles.
# Consumed by dotfiles-init.sh (host) and the onboard script (container).
# Format:  type|relpath|label
#   type    = file | dir   (dirs are symlinked whole; files individually)
#   relpath = path relative to $HOME (repo mirrors $HOME exactly)
#   label   = human-readable description shown in the dotfiles-init checklist
# Blank lines and lines starting with '#' are ignored.

# Shell & editor
file|.zshrc|Zsh config (.zshrc)
file|.bashrc|Bash config (.bashrc)
file|.gitconfig|Git config (.gitconfig)
file|.tmux.conf|tmux config (.tmux.conf)
file|.vimrc|Vim config (.vimrc)
file|.nanorc|Nano config (.nanorc)
file|.editorconfig|EditorConfig (.editorconfig)
file|.curlrc|curl config (.curlrc)
file|.wgetrc|wget config (.wgetrc)

# Claude Code
file|.claude/settings.json|Claude Code settings (.claude/settings.json)
file|.claude/CLAUDE.md|Claude Code global CLAUDE.md (.claude/CLAUDE.md)
dir|.claude/commands|Claude Code commands (.claude/commands/)

# Codex
# Note: ~/.codex is a large runtime-state dir, not just config — it holds
# auth.json (API key + OAuth tokens) and 100s of MB of bundled plugin
# binaries. Only known-safe config files are listed individually below.
file|.codex/config.toml|Codex config (.codex/config.toml)
file|.codex/AGENTS.md|Codex agents config (.codex/AGENTS.md)
file|.codex/RTK.md|Codex RTK config (.codex/RTK.md)
file|.codex/hooks.json|Codex hooks config (.codex/hooks.json)

# Antigravity (agy)
file|.gemini/antigravity-cli/settings.json|Antigravity settings (.gemini/antigravity-cli/settings.json)
file|.gemini/antigravity-cli/keybindings.json|Antigravity keybindings (.gemini/antigravity-cli/keybindings.json)
file|.gemini/antigravity-cli/mcp_config.json|Antigravity MCP config (.gemini/antigravity-cli/mcp_config.json)
dir|.gemini/antigravity-cli/skills|Antigravity skills (.gemini/antigravity-cli/skills/)

# Herdr
# Note: ~/.config/herdr also holds logs, unix sockets, cached release notes,
# and live UI session state — not just config. Only the config file itself
# is tracked; everything else stays local.
file|.config/herdr/config.toml|Herdr config (.config/herdr/config.toml)

# Pi coding agent
# Note: ~/.pi/agent/ holds Pi's config and state (auth included). Only the
# known-safe extension file is tracked; the rest stays local. Override the
# location with PI_CODING_AGENT_DIR if you want state kept out of your dotfiles.
file|.pi/agent/extensions/superset-hooks.ts|Pi superset hooks (.pi/agent/extensions/superset-hooks.ts)

# RTK (Rust Token Killer)
dir|.config/rtk|RTK config dir (.config/rtk/)

# Hermes Agent
# ~/.hermes is its own git repo with its own remote (auth and sessions
# included) — it manages its own sync. Nesting it here via mv+symlink makes
# git record a submodule gitlink instead of real content, so it silently
# pushes as an empty dir on clone. Deliberately not tracked as a dotfile.

# codeburn
dir|.config/codeburn|codeburn config dir (.config/codeburn/)
