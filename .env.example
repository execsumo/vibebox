# Copy this file to .env and adjust values for this sandbox.

# For GPU passthrough with CUDA, start with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build

SANDBOX_NAME=vibebox
SANDBOX_USERNAME=dev
SANDBOX_SSH_PORT=22

# Runaway protections for agent loops and heavy commands.
SANDBOX_MEM_LIMIT=8g
SANDBOX_CPUS=4
SANDBOX_PIDS_LIMIT=1024
BACKUP_RETENTION_DAYS=7

# Tailscale auth key. Generate at https://login.tailscale.com/admin/settings/keys
# Recommended: Reusable + Ephemeral + tagged (tag:vibebox).
# Required — the setup script refuses to run without it. The sandbox shares the
# tailscale container's network namespace, so an unauthenticated tailscale
# crash-loops and takes SSH down with it (there is no interactive fallback).
TS_AUTHKEY=

# Hermes
HERMES_HOSTNAME=hermes #Hostname for the Hermes WebUI node (served at https://<HERMES_HOSTNAME>.<tailnet>.ts.net)
HERMES_WEBUI_PASSWORD=

# Base image: ubuntu:24.04 (default) or nvidia/cuda:latest for GPU tooling.
BASE_IMAGE=ubuntu:24.04

# Tool versions. Defaults to latest; pin only to recreate an older environment.
NODE_MAJOR=22
BUN_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
CODEBURN_VERSION=latest
PI_CODING_AGENT_VERSION=latest
PYRIGHT_VERSION=latest
TYPESCRIPT_VERSION=latest
TYPESCRIPT_LANGUAGE_SERVER_VERSION=latest
VSCODE_LANGSERVERS_VERSION=latest
YAML_LANGUAGE_SERVER_VERSION=latest
BASH_LANGUAGE_SERVER_VERSION=latest
TAILWIND_LANGUAGE_SERVER_VERSION=latest

# (optional) API keys. Every variable in this file reaches the sandbox environment
# and is visible to shells and agents inside it — the list below is just a starting
# point, not an allowlist. Add whatever your tools read; restart to apply.
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=