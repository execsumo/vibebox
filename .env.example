# Copy this file to .env and adjust values for this sandbox.

# Names the containers, Docker volumes, Tailscale node, and backup folder.
# Use a different name for each sandbox you run from this repository pattern.
SANDBOX_NAME=vibebox

# SSH user created inside the container.
SANDBOX_USERNAME=dev

# Local host port for SSH. Change this when running multiple sandboxes on one host.
SSH_PORT=22

# Base image choice:
#   ubuntu:24.04              lightweight LTS default for vibe-coding
#   nvidia/cuda:latest        CUDA runtime if you need GPU tooling
BASE_IMAGE=ubuntu:24.04

# When BASE_IMAGE uses CUDA and you need GPU passthrough, start with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build

# Tool version choices. Use latest by default; set exact versions only when recreating
# an older environment intentionally.
NODE_MAJOR=22
BUN_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
PYRIGHT_VERSION=latest
TYPESCRIPT_VERSION=latest
TYPESCRIPT_LANGUAGE_SERVER_VERSION=latest
VSCODE_LANGSERVERS_VERSION=latest
YAML_LANGUAGE_SERVER_VERSION=latest
BASH_LANGUAGE_SERVER_VERSION=latest
TAILWIND_LANGUAGE_SERVER_VERSION=latest

# Runaway protections for agent loops and accidental heavy commands.
SANDBOX_MEM_LIMIT=8g
SANDBOX_CPUS=4
SANDBOX_PIDS_LIMIT=512

# Backup retention for this sandbox's backups/<SANDBOX_NAME>/ folder.
BACKUP_RETENTION_DAYS=7
