# Copy this file to .env and adjust values for this sandbox.

# Names the containers, Docker volumes, Tailscale node, and backup folder.
# Use a different name for each sandbox you run from this repository pattern.
SANDBOX_NAME=vibebox

# SSH user created inside the container.
SANDBOX_USERNAME=dev

# Local host port for SSH. Change this when running multiple sandboxes on one host.
SSH_PORT=22

# Tailscale auth key for non-interactive login. Without it the tailscale container has
# nothing to authenticate with, so `tailscale up` returns, the container exits (code 0),
# and `restart: unless-stopped` relaunches it ~every minute. Each restart re-creates the
# tailscale network namespace and orphans the sandbox (network_mode: service:tailscale),
# which makes even LOCAL SSH fail with "banner exchange: Connection refused".
#
# Generate one at https://login.tailscale.com/admin/settings/keys. Recommended: mark it
# both *Reusable* and *Ephemeral*:
#   - Reusable  : survives rebuilds; no need to regenerate on every `up`.
#   - Ephemeral : an ephemeral node auto-removes from your tailnet shortly after it goes
#                 offline, so an accidental duplicate self-cleans instead of leaving stale
#                 vibebox-1, vibebox-2, ... entries behind. Trade-off: a sandbox stopped for
#                 a while also disappears from the tailnet until its next `up` (it then
#                 re-registers under the same name).
#
# Node identity lives in the <SANDBOX_NAME>-tailscale-state volume. Keep it: normal
# up/down/--build reuse the same node (no hostname sprawl). It is only re-registered if you
# remove that volume (docker compose down -v, or docker volume rm <name>-tailscale-state).
# Leave blank only if you intend to authenticate interactively via the printed auth URL.
#
# Recommended: generate a *tagged* auth key (select tag:vibebox when creating it) so the
# sandbox comes up tagged automatically. Add a matching entry to your tailnet ACL
# tagOwners (e.g. "tag:vibebox": ["your-user@"]) first, then tailnet ACLs can limit what a
# compromised sandbox — which has passwordless sudo — is able to reach. One-time setup.
TS_AUTHKEY=

# Base image choice:
#   ubuntu:24.04              lightweight LTS default for vibe-coding
#   nvidia/cuda:latest        CUDA runtime if you need GPU tooling
BASE_IMAGE=ubuntu:24.04

# When BASE_IMAGE uses CUDA and you need GPU passthrough, start with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build

# Tool version choices. Use latest by default; set exact versions only when recreating
# an older environment intentionally.
NODE_MAJOR=22
BUN_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
PYRIGHT_VERSION=latest
TYPESCRIPT_VERSION=latest
TYPESCRIPT_LANGUAGE_SERVER_VERSION=latest
VSCODE_LANGSERVERS_VERSION=latest
YAML_LANGUAGE_SERVER_VERSION=latest
BASH_LANGUAGE_SERVER_VERSION=latest
TAILWIND_LANGUAGE_SERVER_VERSION=latest

# API keys for AI coding agents. These are optional at build time — the tools work
# without them and can also be authenticated interactively inside the container.
# Pass them in .env so the container picks them up as environment variables.
XAI_API_KEY=

# Runaway protections for agent loops and accidental heavy commands.
SANDBOX_MEM_LIMIT=8g
SANDBOX_CPUS=4
# 1024 is a safe runaway guard that still leaves headroom for large builds (linkers,
# jest, cargo) which spawn many short-lived processes. Lower it only if you want a
# tighter cap and never run heavy parallel builds.
SANDBOX_PIDS_LIMIT=1024

# Backup retention for this sandbox's backups/<SANDBOX_NAME>/ folder.
BACKUP_RETENTION_DAYS=7
